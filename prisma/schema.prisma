generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoginProvider {
  CREDENTIALS @map("credentials")
  GOOGLE      @map("google")

  @@map("login_provider")
}

model User {
  id        String          @id @default(cuid()) @map("id") @db.VarChar(36)
  username  String          @unique @map("username") @db.VarChar(100)
  email     String          @unique @map("email") @db.VarChar(150)
  avatar    String?         @map("avatar") @db.Text
  image     String?         @map("image") @db.Text
  providers LoginProvider[] @default([]) @map("providers")

  setting     Setting?
  identifiers Identifier[]
  platforms   Platform[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([id], name: "idx_user_id")
  @@index([username], name: "idx_user_username")
  @@index([email], name: "idx_user_email")
  @@index([providers], name: "idx_user_providers")
  @@index([createdAt], name: "idx_user_created_at")
  @@index([updatedAt], name: "idx_user_updated_at")
  @@map("users")
}

enum Theme {
  LIGHT  @map("light")
  DARK   @map("dark")
  SYSTEM @map("system")

  @@map("theme")
}

enum Language {
  EN @map("en")
  ID @map("id")

  @@map("language")
}

model Setting {
  id                     String   @id @default(uuid()) @map("id") @db.VarChar(36)
  theme                  Theme    @default(SYSTEM) @map("theme")
  language               Language @default(ID) @map("language")
  publicAccess           Boolean  @default(false) @map("public_access")
  publicPlatformAccess   Boolean  @default(false) @map("public_platform_access")
  publicIdentifierAccess Boolean  @default(false) @map("public_identifier_access")

  userId String @unique @map("user_id") @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "relation_settings_user")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([id], name: "idx_settings_id")
  @@index([userId], name: "idx_settings_user_id")
  @@index([createdAt], name: "idx_settings_created_at")
  @@index([updatedAt], name: "idx_settings_updated_at_")
  @@map("settings")
}

enum Visibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")

  @@map("visibility")
}

model Identifier {
  id         String     @id @default(uuid()) @map("id") @db.VarChar(36)
  title      String     @map("title") @db.VarChar(100)
  slug       String     @unique @map("slug") @db.VarChar(150)
  visibility Visibility @default(PRIVATE) @map("visibility")
  password   String?    @map("password") @db.VarChar(255)
  thumbnail  String?    @map("thumbnail") @db.Text

  userId String? @map("user_id") @db.VarChar(36)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "relation_identifier_user")
  urls   Url[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([id], name: "idx_identifier_id")
  @@index([title], name: "idx_identifier_title")
  @@index([slug], name: "idx_identifier_slug")
  @@index([userId], name: "idx_identifier_userId")
  @@index([createdAt], name: "idx_identifier_created_at")
  @@index([updatedAt], name: "idx_identifier_updated_at_")
  @@map("identifiers")
}

model Platform {
  id         String     @id @default(uuid()) @map("id") @db.VarChar(36)
  title      String     @map("title") @db.VarChar(100)
  slug       String     @unique @map("slug") @db.VarChar(150)
  visibility Visibility @default(PRIVATE) @map("visibility")
  password   String?    @map("password") @db.VarChar(255)
  thumbnail  String?    @map("thumbnail") @db.Text

  userId String? @map("user_id") @db.VarChar(36)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "relation_platform_user")
  urls   Url[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([id], name: "idx_platform_id")
  @@index([title], name: "idx_platform_title")
  @@index([slug], name: "idx_platform_slug")
  @@index([userId], name: "idx_platform_userId")
  @@index([createdAt], name: "idx_platform_created_at")
  @@index([updatedAt], name: "idx_platform_updated_at_")
  @@map("platforms")
}

model Url {
  id             String   @id @default(uuid()) @map("id") @db.VarChar(36)
  title          String   @map("title") @db.VarChar(100)
  slug           String   @unique @map("slug") @db.VarChar(150)
  description    String?  @map("description")
  url            String   @map("url")
  thumbnail      String?  @map("thumbnail") @db.Text
  images         String[] @default([]) @map("images")
  qrCodeUrl      String?  @map("qr_code_url") @db.Text
  qrEncodedValue String?  @map("qr_encoded_value") @db.Text

  platformId   String?     @map("platform_id") @db.VarChar(36)
  platform     Platform?   @relation(fields: [platformId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "relation_url_platform")
  identifierId String?     @map("identifier_id") @db.VarChar(36)
  identifier   Identifier? @relation(fields: [identifierId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "relation_url_identifier")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([id], name: "idx_url_id")
  @@index([title], name: "idx_url_title")
  @@index([slug], name: "idx_url_slug")
  @@index([platformId], name: "idx_url_platformId")
  @@index([identifierId], name: "idx_url_identifierId")
  @@index([createdAt], name: "idx_url_created_at")
  @@index([updatedAt], name: "idx_url_updated_at_")
  @@map("urls")
}
